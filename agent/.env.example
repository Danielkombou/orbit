# ORBIT Agent Configuration
# Copy to .env and fill in your keys

# LLM Provider: "openai", "anthropic", or "gemini"
LLM_PROVIDER=openai

# OpenRouter config (recommended for free tier)
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
OPENAI_BASE_URL=https://openrouter.ai
# Free models with tool calling support:
# z-ai/glm-5.2:free (256K context, tools)
# minimax/minimax-m3:free (1M context, vision + tools)
# nvidia/nemotron-3-ultra-550b-a55b:free (1M context, tools)
# google/gemma-4-31b-it:free (262K context, vision + tools)
# cohere/north-mini-code:free (256K context, tools)
OPENAI_MODEL=z-ai/glm-5.2:free

# OpenAI direct config (alternative)
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Anthropic config
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini config
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-2.0-flash

# Agent config
MAX_STEPS=20
LLM_MAX_TOKENS=2048
LOG_LEVEL=info

# Live view config
LIVE_VIEW_FPS=2

# Voice config (optional)
VOICE_ENABLED=false
VOICE_WAKE_WORDS=orbit,hey orbit
TTS_VOICE=en-US-GuyNeural
