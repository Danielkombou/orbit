# ORBIT Agent Configuration
# Copy to .env and fill in your keys

# LLM Provider: "openai", "anthropic", or "gemini"
LLM_PROVIDER=gemini

# Gemini config (recommended - free tier with tool calling)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI config (via OpenRouter - note: free :free models do NOT support tool calling)
# OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here
# OPENAI_BASE_URL=https://openrouter.ai
# OPENAI_MODEL=z-ai/glm-5.2:free

# Anthropic config
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Agent config
MAX_STEPS=20
LLM_MAX_TOKENS=2048
LOG_LEVEL=info

# Live view config
LIVE_VIEW_FPS=2

# Voice config (optional)
VOICE_ENABLED=false
VOICE_WAKE_WORDS=orbit,hey orbit
TTS_VOICE=en-US-GuyNeural
